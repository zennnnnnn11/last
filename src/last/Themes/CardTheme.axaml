<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Linear 标志性三次方缓速曲线 (贝塞尔 0.16, 1.0, 0.3, 1.0) -->
    <SplineEasing x:Key="FluentEase" X1="0.16" Y1="1.0" X2="0.3" Y2="1.0" />

    <!-- Linear 主题画刷字典（Default 暗色 / Light 浅色） -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- 核心卡片表面 -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#13151C" />
            <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#181B24" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#262938" />
            <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#373B50" />
            <BoxShadows x:Key="CardBoxShadow">0 2 8 0 #50000000</BoxShadows>
            <BoxShadows x:Key="CardHoverBoxShadow">0 4 16 0 #70000000</BoxShadows>

            <!-- 次级微表面与边框 -->
            <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#1B1E28" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#2B2F3E" />
            <SolidColorBrush x:Key="AvatarPlaceholderBrush" Color="#33384A" />

            <!-- 文字层级体系 -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#828898" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A3B8" />

            <!-- 在线与就绪状态徽标 -->
            <SolidColorBrush x:Key="StatusOnlineBgBrush" Color="#102A20" />
            <SolidColorBrush x:Key="StatusOnlineBorderBrush" Color="#1B523D" />
            <SolidColorBrush x:Key="StatusOnlineTextBrush" Color="#34D399" />
            <SolidColorBrush x:Key="StatusOnlineDotBrush" Color="#10B981" />

            <!-- 离线状态徽标 -->
            <SolidColorBrush x:Key="StatusOfflineBgBrush" Color="#181B22" />
            <SolidColorBrush x:Key="StatusOfflineBorderBrush" Color="#282C38" />
            <SolidColorBrush x:Key="StatusOfflineTextBrush" Color="#808696" />
            <SolidColorBrush x:Key="StatusOfflineDotBrush" Color="#606675" />

            <!-- 底部指示条 -->
            <SolidColorBrush x:Key="PaginationInactiveBrush" Color="#2B2F3E" />

            <!-- 候补席卡槽 -->
            <SolidColorBrush x:Key="BenchSlotBgBrush" Color="#181B26" />
            <SolidColorBrush x:Key="BenchSlotBorderBrush" Color="#282D3D" />
            <SolidColorBrush x:Key="BenchSlotHoverBorderBrush" Color="#4F5872" />
            <SolidColorBrush x:Key="BenchSlotEmptyBorderBrush" Color="#202432" />
            <SolidColorBrush x:Key="BenchPriorityBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="BenchBuffBrush" Color="#10B981" />
            <SolidColorBrush x:Key="BenchNerfBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="BenchBadgeBgBrush" Color="#E6181B24" />
            <!-- 4% 微透光发丝边收边画刷 (Dark) -->
            <SolidColorBrush x:Key="BenchAvatarHairlineBrush" Color="#0AFFFFFF" />

            <!-- 阵营标识画刷 (Dark) -->
            <SolidColorBrush x:Key="TeamAllyAccentBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="TeamAllyBgBrush" Color="#132338" />
            <SolidColorBrush x:Key="TeamAllyBorderBrush" Color="#1E3A5F" />
            <SolidColorBrush x:Key="TeamEnemyAccentBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="TeamEnemyBgBrush" Color="#2B151A" />
            <SolidColorBrush x:Key="TeamEnemyBorderBrush" Color="#4A1E24" />

            <!-- 战绩走势微点与通栏行悬浮 (Dark) -->
            <SolidColorBrush x:Key="MatchWinDotBrush" Color="#10B981" />
            <SolidColorBrush x:Key="MatchLossDotBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="MatchEmptyDotBrush" Color="#2B2F3E" />
            <SolidColorBrush x:Key="PlayerRowHoverBgBrush" Color="#181B26" />

            <!-- Linear 极简流线型微胶囊滚动条画刷 (Dark) -->
            <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#25FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#45FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- 核心卡片表面（白瓷卡片） -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardHoverBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
            <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#D1D5DB" />
            <BoxShadows x:Key="CardBoxShadow">0 1 3 0 #0A000000, 0 4 12 0 #08000000</BoxShadows>
            <BoxShadows x:Key="CardHoverBoxShadow">0 2 6 0 #0F000000, 0 6 16 0 #0D000000</BoxShadows>

            <!-- 次级微表面与边框 -->
            <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="AvatarPlaceholderBrush" Color="#CBD5E1" />

            <!-- 文字层级体系 -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#475569" />

            <!-- 在线与就绪状态徽标 -->
            <SolidColorBrush x:Key="StatusOnlineBgBrush" Color="#ECFDF5" />
            <SolidColorBrush x:Key="StatusOnlineBorderBrush" Color="#A7F3D0" />
            <SolidColorBrush x:Key="StatusOnlineTextBrush" Color="#047857" />
            <SolidColorBrush x:Key="StatusOnlineDotBrush" Color="#10B981" />

            <!-- 离线状态徽标 -->
            <SolidColorBrush x:Key="StatusOfflineBgBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="StatusOfflineBorderBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="StatusOfflineTextBrush" Color="#64748B" />
            <SolidColorBrush x:Key="StatusOfflineDotBrush" Color="#94A3B8" />

            <!-- 底部指示条 -->
            <SolidColorBrush x:Key="PaginationInactiveBrush" Color="#E2E8F0" />

            <!-- 候补席卡槽 -->
            <SolidColorBrush x:Key="BenchSlotBgBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="BenchSlotBorderBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="BenchSlotHoverBorderBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="BenchSlotEmptyBorderBrush" Color="#EDF2F7" />
            <SolidColorBrush x:Key="BenchPriorityBrush" Color="#D97706" />
            <SolidColorBrush x:Key="BenchBuffBrush" Color="#059669" />
            <SolidColorBrush x:Key="BenchNerfBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="BenchBadgeBgBrush" Color="#E6FFFFFF" />
            <!-- 4% 微透光发丝边收边画刷 (Light) -->
            <SolidColorBrush x:Key="BenchAvatarHairlineBrush" Color="#0A000000" />

            <!-- 阵营标识画刷 (Light) -->
            <SolidColorBrush x:Key="TeamAllyAccentBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="TeamAllyBgBrush" Color="#EFF6FF" />
            <SolidColorBrush x:Key="TeamAllyBorderBrush" Color="#BFDBFE" />
            <SolidColorBrush x:Key="TeamEnemyAccentBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="TeamEnemyBgBrush" Color="#FEF2F2" />
            <SolidColorBrush x:Key="TeamEnemyBorderBrush" Color="#FECACA" />

            <!-- 战绩走势微点与通栏行悬浮 (Light) -->
            <SolidColorBrush x:Key="MatchWinDotBrush" Color="#10B981" />
            <SolidColorBrush x:Key="MatchLossDotBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="MatchEmptyDotBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="PlayerRowHoverBgBrush" Color="#F1F5F9" />

            <!-- Linear 极简流线型微胶囊滚动条画刷 (Light) -->
            <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#25000000" />
            <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#45000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>