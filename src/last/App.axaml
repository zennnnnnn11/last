<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="last.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 全局统一字体资产：优先 MiSans，优雅回落至 Segoe UI Variable、Segoe UI、微软雅黑与系统无衬线字体 -->
            <FontFamily x:Key="AppFontFamily">MiSans, Segoe UI Variable, Segoe UI, Microsoft YaHei UI, -apple-system, BlinkMacSystemFont, sans-serif</FontFamily>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://last/Themes/WindowActionCapsuleTheme.axaml" />
                <ResourceInclude Source="avares://last/Themes/CardTheme.axaml" />
                <ResourceInclude Source="avares://last/Themes/SegmentedAutomationSwitchTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- 全局窗口默认字体规范 -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        </Style>

        <!-- 微软原生 Fluent 质感卡片容器样式（直接定义在 non-templated Border 控件上） -->
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardBoxShadow}" />
            <!-- ClipToBounds 设为 False，避免裁掉外层投影 BoxShadow -->
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="{StaticResource FluentEase}" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="{StaticResource FluentEase}" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" Easing="{StaticResource FluentEase}" />
                </Transitions>
            </Setter>
        </Style>

        <!-- 微软原生悬停态：细腻的背景微透光过渡，无彩色边框与跳动 -->
        <Style Selector="Border.Card:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource CardHoverBoxShadow}" />
        </Style>

        <!-- Linear 极简白瓷质感全局 ToolTip 规范 -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BoxShadow="{DynamicResource CardHoverBoxShadow}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Linear 极简精致 MenuFlyout 浮层规范（半透深色卡片表面、1px细边框与微胶囊列表项） -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="132" />
        </Style>

        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="8, 6" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0, 1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        </Style>
        <Style Selector="MenuItem:selected">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
        </Style>

        <!-- Linear 极简流线型全局微胶囊滚动条规范 (告别传统粗灰底轨与上下小箭头) -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ScrollBar:expanded">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
        </Style>

        <Style Selector="ScrollBar:vertical:expanded">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
        </Style>

        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
        </Style>

        <Style Selector="ScrollBar:horizontal:expanded">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
        </Style>

        <!-- 彻底隐藏并折叠所有上/下/左/右箭头按钮 -->
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
        </Style>

        <!-- 轨道容器内部边框与背景彻底透明 -->
        <Style Selector="ScrollBar /template/ Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- 极简微胶囊滑块：圆角微药丸、半透微质感、自适应主题 -->
        <Style Selector="ScrollBar /template/ Thumb#PART_Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="MinHeight" Value="24" />
        </Style>

        <Style Selector="ScrollBar /template/ Thumb#PART_Thumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
        </Style>

        <Style Selector="ScrollBar /template/ Thumb#PART_Thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
        </Style>
    </Application.Styles>
</Application>